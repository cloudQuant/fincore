include LICENSE
include NOTICE
include THIRD_PARTY_NOTICES.md
include THIRD_PARTY_LICENSES/Apache-2.0.txt
include README.md
include pyproject.toml
# Contributor and test requirements are deliberately not distribution inputs.
exclude requirements.txt
exclude requirements-test.txt
recursive-include fincore *.py
# Runtime report assets (vendored ECharts for offline HTML/PDF reports)
recursive-include fincore/report/assets *.js
include fincore/py.typed
recursive-exclude tests *
recursive-exclude examples *
recursive-exclude docs *
prune build
prune dist
prune *.egg-info
