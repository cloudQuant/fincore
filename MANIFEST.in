include LICENSE
include README.md
include pyproject.toml
include requirements.txt
include requirements-test.txt
recursive-include fincore *.py
# Runtime report assets (vendored ECharts for offline HTML/PDF reports)
recursive-include fincore/report/assets *.js
include fincore/py.typed
recursive-exclude tests *
recursive-exclude examples *
recursive-exclude docs *
prune build
prune dist
prune *.egg-info
